GEMINI_API_KEY=
IIT_VOICE_AI_MODEL=gemini-3.5-flash-lite

# Local testing only; never enable on a publicly hosted instance.
IIT_VOICE_DEMO_LOGIN=0
# Temporary evidence-free completion/closure testing. Local isolated demo only.
IIT_VOICE_TEST_COMPLETION_BYPASS=0

# Server-side only. Supabase Connect > Transaction pooler connection URI.
# Leave blank to continue using local SQLite. Never prefix with VITE_.
DATABASE_URL=
# Optional online demos: restricted role for the separate iit_voice_demo schema.
# Generated by python3 -B setup_online_demo.py; never reuse the owner DATABASE_URL.
DEMO_DATABASE_URL=
# Vercel enables secure cookies automatically; enable this for other HTTPS hosts.
IIT_VOICE_SECURE_COOKIE=0

# Optional Google sign-in via Supabase Auth; enable the Google provider first.
# Use the project's HTTPS URL and publishable key (or legacy anon key), NOT service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Exact origin: http://127.0.0.1:5173 locally; https://iit-voice.vercel.app on Vercel.
IIT_VOICE_PUBLIC_URL=
